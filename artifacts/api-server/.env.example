# Copy to .env for local development. Never commit real values.
# In production (NODE_ENV=production) the server refuses to start without TOKEN_SECRET.

PORT=5001
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/snapcontact

# Signs sign-in sessions. At least 32 random characters, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out.
TOKEN_SECRET=

# Public https address of this API (used for Cashfree return and webhook URLs).
PUBLIC_BASE_URL=http://localhost:5001

# Cashfree Payment Gateway (dashboard -> Developers -> API Keys). All three are required,
# or payments are disabled. Use SANDBOX keys with SANDBOX and production keys with PRODUCTION.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX

# Username sign-up: encrypts the password until its credentials email is sent. Exactly 32 random
# bytes, base64 (e.g. `openssl rand -base64 32`). Without it, username sign-up returns 503.
# Changing it makes pending (not yet emailed) sign-ups fail; they can be started again.
CREDENTIAL_KEY=

# Email for sign-in codes: Brevo HTTPS API (works on Render free) or SMTP.
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google sign-in: comma-separated OAuth client IDs (Web, Android, iOS).
GOOGLE_CLIENT_IDS=

# Enables /api/admin (x-admin-key header). Leave empty to disable admin routes.
ADMIN_KEY=
