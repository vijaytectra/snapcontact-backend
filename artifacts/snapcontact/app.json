{
  "expo": {
    "name": "SnapContact",
    "slug": "snapcontact",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snapcontact",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.snapcontact.capture",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo to find phone numbers on this device. Photos are not uploaded.",
        "NSPhotoLibraryUsageDescription": "Choose a screenshot or photo to read on this device. Nothing is uploaded.",
        "NSContactsUsageDescription": "Open your contact editor only when you choose to save a reviewed number.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "app.snapcontact.capture",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3EEE3"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      ["expo-image-picker", {
        "photosPermission": "Choose a screenshot or photo to read on this device. Nothing is uploaded.",
        "cameraPermission": "Photograph a number to read it on this device. Nothing is uploaded.",
        "microphonePermission": false
      }],
      "./plugins/withSnapCapture.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
